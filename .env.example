# NeonのPostgres接続文字列（Neonダッシュボードの「Connection string」からコピー）
DATABASE_URL=

# LINE Developers > Messaging APIチャネル > 「Messaging API設定」タブ
LINE_CHANNEL_ACCESS_TOKEN=
# LINE Developers > Messaging APIチャネル > 「チャネル基本設定」タブ
LINE_CHANNEL_SECRET=

# LINE Developers > LINEログインチャネル（LIFF用の別チャネル）> 「チャネル基本設定」タブの Channel ID
LINE_LOGIN_CHANNEL_ID=
# 同チャネルの「LIFF」タブでLIFFアプリを追加すると発行される。クライアント側(ブラウザ)でも参照するためNEXT_PUBLIC_接頭辞が必須
NEXT_PUBLIC_LIFF_ID=
